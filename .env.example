# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，请勿提交到代码仓库
# ============================================================

# ---------- 阿里云百炼 DashScope（必填）----------
# 获取地址：https://bailian.console.aliyun.com/  ->  右上角「API-KEY」-> 创建
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 模型配置 ----------
# Embedding 模型：text-embedding-v1 / v2 / v3（v3 效果最好）
EMBEDDING_MODEL=text-embedding-v3
# 对话模型：qwen-plus / qwen-max / qwen-turbo / qwen-long
LLM_MODEL=qwen-plus

# ---------- 向量库配置 ----------
# Chroma 持久化目录（相对项目根目录）
CHROMA_PERSIST_DIR=vector_store
# 集合名称
COLLECTION_NAME=enterprise_kb

# ---------- 文档切分配置 ----------
# 每个切片的最大字符数
CHUNK_SIZE=800
# 相邻切片的重叠字符数（建议为 CHUNK_SIZE 的 10%~20%）
CHUNK_OVERLAP=120

# ---------- 检索配置 ----------
# 每次召回的知识片段数量
TOP_K=4

# ---------- Agent 知识库（Chroma，持久化到 ./chroma_kb）----------
# 向量模型：text-embedding-v4（Qwen3-Embedding 系列，默认 1024 维，单次最多 10 条文本）
KB_EMBEDDING_MODEL=text-embedding-v4
# 向量库持久化目录（相对项目根目录）
CHROMA_KB_DIR=./chroma_kb
# 集合名称
KB_COLLECTION_NAME=enterprise_kb

# ---------- 重排序（Rerank：两阶段检索的「精排」）----------
# 是否启用重排序：先用向量多召回一批候选，再用排序模型逐对打分精排，提升 Top-1 命中率
RERANK_ENABLED=true
# 排序模型（需先在百炼控制台开通该模型；未开通会返回 403 Access denied）
RERANK_MODEL=gte-rerank
# 配置的模型在当前账号下不可用时，按顺序自动回退的备用模型（逗号分隔）
# 百炼当前对外服务的是 gte-rerank-v2
RERANK_FALLBACK_MODELS=gte-rerank-v2
# 向量粗排候选数；0 = 自动（TOP_K × RERANK_RECALL_MULTIPLIER，且不低于 10 条，不超过库内总数）
RERANK_RECALL_K=0
# 自动计算候选数时的倍数
RERANK_RECALL_MULTIPLIER=3
